{
  "name": "dsh-snap",
  "version": "0.1.0",
  "description": "Screenshot directly into the chat composer for DeepSeek Harness — click the scissors, drag a region, the image lands in the input box.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "bin", "cordis.patch.yml"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "screenshot", "capture", "cordis"],
  "license": "MIT",
  "os": ["win32"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots"],
      "platform": "web",
      "immediately": true
    }
  }
}
